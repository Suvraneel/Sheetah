{
  "name": "sheetah",
  "private": true,
  "version": "1.0.0",
  "description": "A spreadsheet that opens millions of rows and speaks SQL, running entirely in your browser (DuckDB-WASM).",
  "license": "MIT",
  "homepage": "https://sheetah.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suvraneel/Sheetah.git"
  },
  "bugs": "https://github.com/Suvraneel/Sheetah/issues",
  "engines": {
    "node": ">=22.12 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prebuild": "node scripts/fetch-duckdb-extensions.mjs",
    "test": "npm run build && playwright test --project=unit && playwright test --project=chromium --grep-invert @perf && playwright test --project=chromium --grep @perf --workers=1",
    "test:e2e": "playwright test --project=chromium --grep-invert @perf",
    "test:perf": "playwright test --project=chromium --grep @perf --workers=1",
    "test:unit": "playwright test --project=unit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "apache-arrow": "21.2.0",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
